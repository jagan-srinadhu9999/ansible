---
- name: install nginx and nsure Nginx is running, and report its status without making
  hosts: web
  become: true

  vars:
    packages:

      - nginx
      - unzip

  tasks:
    - name: install nginx and unzip
      ansible.builtin.package:
        name: "{{item}}"
        state: present
      loop: "{{packages}}"

    - name: start and enable nginx
      ansible.builtin.service:
        name: nginx
        state: started
        enabled: true
    - name: check nginx is active or not
      ansible.builtin.command: systemctl is-active nginx
      register: nginx_status
      changed_when: false
      failed_when: false
      

    - name: print nginx status
      ansible.builtin.debug:
        msg: "Nginx status is {{ nginx_status.stdout }}"
      when: nginx_status.stdout == "active"

    - name: report failuer
      ansible.builtin.debug:
         msg: "Nginx is not running."
      when: nginx_status.stdout != "active"

    - name: gather service information
      ansible.builtin.service_facts:
    
    - name: Display Nginx service information
        ansible.builtin.debug:
            var: ansible_facts.services['nginx.service']
    