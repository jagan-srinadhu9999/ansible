---
- name: install ngnix and nsure Nginx is running, and report its status without making
  hosts: web
  become: true

  vars:
    packages:

      - ngnix
      - unzip

  tasks:
    - name: install ngnix and unzip
      ansible.builtin.package:
        name: "{{item}}"
        state: present
      loop: "{{vars.packages}}

    - name: start and enable ngnix
      ansible.builtin.service:
        name: ngnix
        state: started
    - name: check ngnix is active or not
      ansible.builtin.command: systemctl is-active nginx
      register: ngnix_status
      changed_when: false
      

    - name: print ngnix status
      ansible.builtin.debug:
        msg: 'ngnix status is "{{ngnix_status.stdout}}"'